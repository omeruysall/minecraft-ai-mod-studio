{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-ai-mod-studio.local/schemas/project.schema.json",
  "title": "Minecraft AI Mod Studio Project",
  "type": "object",
  "required": ["schema_version", "project_id", "name", "minecraft", "workflow", "components", "requirements"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "minecraft": {
      "type": "object",
      "required": ["edition", "version"],
      "properties": {
        "edition": {"type": "string", "enum": ["java", "bedrock"]},
        "version": {"type": "string", "minLength": 1},
        "loader": {"type": ["string", "null"], "enum": ["neoforge", "forge", "fabric", "paper", "spigot", "bukkit", null]},
        "java_runtime": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["mode", "status", "approval_required"],
      "properties": {
        "mode": {"const": "guided"},
        "status": {"type": "string", "enum": ["draft", "planning", "awaiting_approval", "approved", "generating", "integrating", "testing", "delivered", "blocked"]},
        "approval_required": {"type": "boolean", "const": true},
        "approved_revision": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "world_strategy": {"type": "string", "enum": ["prepared", "procedural", "hybrid"]},
    "components": {
      "type": "object",
      "properties": {
        "mod": {"type": "boolean"},
        "world": {"type": "boolean"},
        "datapack": {"type": "boolean"},
        "resource_pack": {"type": "boolean"},
        "quests": {"type": "boolean"},
        "server_plugin": {"type": "boolean"},
        "bedrock_addon": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "status"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "category": {"type": "string"},
          "status": {"type": "string", "enum": ["proposed", "approved", "implemented", "tested", "blocked"]},
          "target_component": {"type": ["string", "null"]}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "kind": {"type": "string", "enum": ["requires", "references", "generates", "tests"]}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
